@{
    Layout = null;
    ViewData["Title"] = "Galaxy Welcome Page";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/welcome.css" asp-append-version="true" />
</head>
<body>
    <div class="nebula nebula-1" aria-hidden="true"></div>
    <div class="nebula nebula-2" aria-hidden="true"></div>

    <div class="twinkle-container" aria-hidden="true">
        <div class="glitter-star medium g1"></div>
        <div class="glitter-star small g2"></div>
        <div class="glitter-star large g3"></div>
        <div class="glitter-star small g4"></div>
        <div class="glitter-star medium g5"></div>
        <div class="glitter-star large g6"></div>
        <div class="glitter-star small g7"></div>
        <div class="glitter-star medium g8"></div>
        <div class="glitter-star small g9"></div>
        <div class="glitter-star medium g10"></div>
        <div class="glitter-star large g11"></div>
        <div class="glitter-star small g12"></div>
        <div class="glitter-star medium g13"></div>
        <div class="glitter-star large g14"></div>
        <div class="glitter-star small g15"></div>
        <div class="glitter-star medium g16"></div>
        <div class="glitter-star small g17"></div>
        <div class="glitter-star large g18"></div>
        <div class="glitter-star medium g19"></div>
        <div class="glitter-star small g20"></div>
    </div>

    <div class="rain-container" aria-hidden="true">
        <div class="diagonal-star rain-1"></div>
        <div class="diagonal-star rain-2"></div>
        <div class="diagonal-star rain-3"></div>
        <div class="diagonal-star rain-4"></div>
        <div class="diagonal-star rain-5"></div>
        <div class="diagonal-star rain-6"></div>
        <div class="diagonal-star rain-7"></div>
        <div class="diagonal-star rain-8"></div>
        <div class="diagonal-star rain-9"></div>
        <div class="diagonal-star rain-10"></div>
    </div>

    <main class="welcome-card">
        <h1>Welcome Cosmos</h1>
        <p>Step into the infinite expanse. Discover new worlds, navigate through shining stars, and explore beyond boundaries.</p>
        <div class="button-group">
            <button class="galaxy-btn" type="button"><span aria-hidden="true">🚀</span> AMOR</button>
            <button class="galaxy-btn" type="button"><span aria-hidden="true">🗺️</span> CONDE</button>
           <a class="galaxy-btn" asp-controller="Home" asp-action="Portfolio"><span aria-hidden="true">✨</span> MABUTE</a>
        </div>
    </main>
</body>
</html>
